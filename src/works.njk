---
title: "Works"
---

{% extends "layout/layout.njk" %}
{% block main %}
  <div class="container mx-auto py-16">
    <div class="grid lg:grid-cols-2 grid-cols-1 xl:gap-16 gap-8">
      {%- for work in collections.works | reverse -%}
        <a href="{{ work.data.link }}" title="{{ work.data.title }}" class="cursor-pointer base-transition text-transition">
          <div>
            {% image work.data.img, work.data.title, "img-transition rounded-xl", ["900, 600"] %}
          </div>
          <div class="py-4">
            <p class="md:text-2xl text-xl font-semibold flex items-center">{{ work.data.title }}</p>
            <p class="text-neutral-950">
              {% for type in work.data.types | join(", ") -%}
                {{ type }}
              {%- endfor %}
            </p>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
{% endblock main %}